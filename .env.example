# DocMindAI 환경 변수 예시
# 이 파일을 .env 로 복사 후 실제 값을 입력하세요:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# 번역 API 키 (사용하는 엔진에 맞게 설정)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
DEEPL_API_KEY=...
GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# REST API 서버 설정
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# API_RELOAD=false        # true로 설정 시 파일 변경 감지 자동 재시작 (개발용)
# API_WORKERS=1           # 프로세스 수 (멀티프로세싱은 모델 공유 불가로 1 권장)

# ---------------------------------------------------------------------------
# Ollama 로컬 LLM 서버 (선택적)
# ---------------------------------------------------------------------------
# Ollama 서버 URL — 미설정 시 docker-compose 기본값 사용
# 웹 UI 사이드바 "🦙 Ollama 서버 설정" 에서도 변경 가능 (세션 기간 유지)
#
# ※ Docker 환경 주의:
#   - 호스트 머신의 Ollama에 접속할 때 localhost 는 컨테이너 자신을 가리킴
#   - docker-compose.yaml 이 host.docker.internal:11434 를 기본값으로 설정하므로
#     대부분 별도 설정 불필요
#   - 원격 Ollama 서버 사용 시에만 아래 주석을 해제하고 IP 입력
# OLLAMA_BASE_URL=http://192.168.1.10:11434

# ---------------------------------------------------------------------------
# Dify 지식 베이스 (선택적)
# ---------------------------------------------------------------------------
# Dify 서버 API URL (클라우드: https://api.dify.ai/v1, 자체 호스팅: http://<host>/v1)
# DIFY_API_URL=https://api.dify.ai/v1
#
# Dify API 키: Dify → 설정 → API 키에서 발급
# DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 번역 결과를 저장할 기본 데이터셋(지식 베이스) ID
# (설정하면 웹 UI 사이드바 드롭다운의 기본값으로 사용됨)
# DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Streamlit UI 포트
# ---------------------------------------------------------------------------
UI_PORT=8501
